{
  "name": "bili-cocoon",
  "version": "0.1.0",
  "description": "度量 B站推荐流的信息茧房程度（零依赖）",
  "type": "module",
  "main": "src/index.js",
  "bin": { "bili-cocoon": "src/cli.js" },
  "exports": {
    ".": "./src/index.js",
    "./metrics": "./src/metrics.js",
    "./api": "./src/api.js"
  },
  "files": ["src", "SPEC.md", "README.md"],
  "scripts": {
    "collect": "node src/cli.js collect",
    "score": "node src/cli.js score",
    "report": "node src/cli.js report",
    "test": "node test/metrics.test.js",
    "test:all": "node --test --test-isolation=none test/*.test.js"
  },
  "engines": { "node": ">=22" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iseapisu/dsh-bilibili-cocoon.git"
  },
  "bugs": { "url": "https://github.com/Iseapisu/dsh-bilibili-cocoon/issues" },
  "homepage": "https://github.com/Iseapisu/dsh-bilibili-cocoon#readme",
  "keywords": [
    "bilibili",
    "recommendation",
    "filter-bubble",
    "echo-chamber",
    "data-visualization",
    "deepseek-harness",
    "nodejs",
    "cli",
    "sqlite",
    "privacy"
  ],
  "license": "MIT",
  "private": true
}
